# Docker Hub image override (used by Jenkins when deploying via Compose)
# Set to YOUR_DOCKERHUB_USERNAME/placement-portal:BUILD_NUMBER by Jenkins automatically
APP_IMAGE=placement-portal:local

# Database
DB_NAME=placement_portal
DB_PASSWORD=rootpassword
DB_PORT=3306

# App port (must match Jenkinsfile smoke test URL)
SERVER_PORT=8081

# Demo login passwords (change for production!)
DEMO_PASSWORD_STUDENT=Student@123
DEMO_PASSWORD_OFFICER=Officer@123
DEMO_PASSWORD_ADMIN=Admin@123
